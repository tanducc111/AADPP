APP_NAME=AADPP API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg2://aadpp_user:aadpp_password@postgres:5432/aadpp
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
JWT_SECRET_KEY=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://frontend:3000
